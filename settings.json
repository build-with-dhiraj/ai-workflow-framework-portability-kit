{
  "cleanupPeriodDays": 99999,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "Grep(*)",
      "Glob(*)",
      "TodoWrite(*)"
    ]
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "vercel-plugin@vercel-vercel-plugin": false,
    "superpowers@superpowers-marketplace": true,
    "superpowers-chrome@superpowers-marketplace": true,
    "superpowers-developing-for-claude-code@superpowers-marketplace": true,
    "superpowers-lab@superpowers-marketplace": true,
    "andrej-karpathy-skills@karpathy-skills": true,
    "github@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "youdotcom-agent-skills@claude-plugins-official": true,
    "claude-seo@agricidaniel-seo": true,
    "productivity@knowledge-work-plugins": true,
    "cowork-plugin-management@knowledge-work-plugins": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      },
      "autoUpdate": true
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      },
      "autoUpdate": true
    },
    "ponytail": {
      "source": {
        "source": "git",
        "url": "https://github.com/DietrichGebert/ponytail.git"
      }
    },
    "agricidaniel-seo": {
      "source": {
        "source": "directory",
        "path": "/Users/Dhiraj/.claude/plugins/local-src/claude-seo"
      }
    },
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    }
  },
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "teammateMode": "in-process",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(glab:*) read-only subcommands in this project (glab issue list, glab mr list, glab repo view) against gitlab.com",
      "Bash(gcloud:*) read-only inspection in this project (gcloud config list, gcloud auth list, gcloud projects list)",
      "Bash(obsidian-graph-audit:*) and Bash(obsidian-brain-eval:*) local vault audit runs in this project"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(glab:*) destructive or publishing subcommands in this project (glab mr merge, glab repo delete, glab release create) against gitlab.com",
      "Bash(gcloud:*) mutating subcommands in this project (gcloud storage rm, gcloud iam *, gcloud run deploy, gcloud projects delete)"
    ]
  }
}
